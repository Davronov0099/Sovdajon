generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  CASHIER
  HELPER
}

enum PaymentMethod {
  CASH
  CARD
  CLICK
  TRANSFER
  DEBT
  MIXED
}

enum DebtStatus {
  ACTIVE
  PARTIAL
  PAID
  OVERDUE
  CONFLICT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SalaryStatus {
  DRAFT
  CALCULATED
  RECALCULATED
  PAID
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
}

enum ProductUnit {
  PIECE
  KG
  METER
  SET
  PACK
  BOX
}

// ==================== MODELS ====================

model User {
  id        String   @id @default(uuid())
  login     String   @unique
  password  String
  name      String
  role      Role     @default(HELPER)
  phone     String?
  avatar    String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  receipts       Receipt[]
  auditLogs      AuditLog[]
  attendances    Attendance[]
  salaries       Salary[]
  salarySettings SalarySetting?
  advances       Advance[]       @relation("AdvanceUser")
  approvedAdvances Advance[]     @relation("AdvanceApprover")
  cashierSessions CashierSession[]
  debtPayments   DebtPayment[]
  debtExtensions DebtExtension[] @relation("DebtExtensionApprover")
  debtsCreated   Debt[]          @relation("DebtCreator")
  kpiAssignments KpiAssignment[]
  kpiRecords     KpiRecord[]
  fines          Fine[]          @relation("FineUser")
  finesCreated   Fine[]          @relation("FineCreator")
  expenses       Expense[]
  customersCreated Customer[]    @relation("CustomerCreator")
  contactsCreated  Contact[]     @relation("ContactCreator")
  ordersCreated    Order[]       @relation("OrderCreator")

  @@index([login])
  @@index([role])
  @@index([isDeleted])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("string") // string, number, boolean, json

  @@index([key])
}

model Product {
  id            String      @id @default(uuid())
  code          Int?        @unique // Tez qidirish — kassir kod yozadi (o'chirilganda null bo'ladi, kod qayta ishlatiladi)
  name          String
  price         Decimal     @db.Decimal(12, 2)             // Dona narxi (asosiy sotuv narxi)
  costPrice     Decimal     @db.Decimal(12, 2)             // Tan narxi
  minSellingPrice Decimal?  @db.Decimal(12, 2)             // Min sotuv narxi (bundan past sotib bo'lmaydi)
  wholesalePrice  Decimal?  @db.Decimal(12, 2)             // Optom sotuv narxi
  dollarRate    Decimal?    @db.Decimal(12, 4)             // Legacy: hozir ishlatilmaydi

  stock         Int         @default(0)   // DO'KON stock (mahsulotlar bo'limi/savdo zalida)
  minStock      Int         @default(5)
  unit          ProductUnit @default(PIECE)
  boxQuantity   Int         @default(1)   // 1 quti = necha dona (masalan 20)
  meterPerRoll  Float?                    // 1 o'ram = necha metr (metr mahsulotlar uchun)
  packQuantity  Int?                      // 1 pachka = necha dona
  categoryId    String
  subCategoryId String?
  images        String[]    @default([])
  description   String?
  isMarketplaceVisible Boolean   @default(false)
  showPrice            Boolean   @default(true)
  isDeleted     Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  category     Category      @relation(fields: [categoryId], references: [id])
  subCategory  SubCategory?  @relation(fields: [subCategoryId], references: [id])
  priceHistory PriceHistory[]
  receiptItems ReceiptItem[]
  returnItems  ReturnReceiptItem[]
  supplierTransactionItems SupplierTransactionItem[]
  orderItems   OrderItem[]
  marketplaceOrderItems MarketplaceOrderItem[]
  warehouseStocks WarehouseStock[]
  stockMovements  StockMovement[]

  @@index([code])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isDeleted])
  @@index([name])
  @@index([isDeleted, createdAt])
  @@index([stock])
  // Full-text search (manual migration): CREATE INDEX product_search_idx ON "Product" USING GIN (to_tsvector('simple', name));
}

model Category {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  products      Product[]
  subCategories SubCategory[]

  @@index([order])
}

model SubCategory {
  id         String   @id @default(uuid())
  name       String
  categoryId String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  category Category  @relation(fields: [categoryId], references: [id])
  products Product[]

  @@index([categoryId])
}

model PriceHistory {
  id           String   @id @default(uuid())
  productId    String
  oldPrice     Decimal  @db.Decimal(12, 2)
  newPrice     Decimal  @db.Decimal(12, 2)
  oldCostPrice Decimal? @db.Decimal(12, 2)
  newCostPrice Decimal? @db.Decimal(12, 2)
  reason       String   // MANUAL, SUPPLIER_IMPORT, BULK_UPDATE
  createdById  String
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

model Receipt {
  id              String        @id @default(uuid())
  number          Int           @default(autoincrement())
  subtotal        Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  cashReceived    Decimal?      @db.Decimal(12, 2)
  change          Decimal?      @db.Decimal(12, 2)
  mixedPayments   Json?         // [{method, amount}] — faqat MIXED uchun
  customerId      String?
  createdById     String
  isDraft         Boolean       @default(false)
  source          String        @default("POS")   // POS | HELPER
  createdAt       DateTime      @default(now())

  // Relations
  items     ReceiptItem[]
  customer  Customer?      @relation(fields: [customerId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  debts     Debt[]
  returns   ReturnReceipt[]

  @@index([createdById])
  @@index([customerId])
  @@index([createdAt])
  @@index([isDraft])
  @@index([source])
}

model ReceiptItem {
  id        String  @id @default(uuid())
  receiptId String
  productId String
  productName String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  costPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
}

model CustomerCategory {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  customers Customer[]

  @@index([order])
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  phone       String    @unique
  email       String?
  address     String?
  debtLimit   Decimal?  @db.Decimal(12, 2)
  loyaltyPoints Int     @default(0)
  note        String?
  startDate   DateTime?
  categoryId  String?
  createdById String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category  CustomerCategory? @relation(fields: [categoryId], references: [id])
  createdBy User?     @relation("CustomerCreator", fields: [createdById], references: [id])
  receipts  Receipt[]
  debts     Debt[]
  orders    Order[]

  @@index([phone])
  @@index([name])
  @@index([categoryId])
  @@index([isDeleted])
}

model Debt {
  id              String     @id @default(uuid())
  customerId      String
  receiptId       String?
  amount          Decimal    @db.Decimal(12, 2)
  remainingAmount Decimal    @db.Decimal(12, 2)
  status          DebtStatus @default(ACTIVE)
  dueDate         DateTime
  note            String?
  collateral      String?   // Garov (masalan "pasport", "texnika")
  offlineId       String?    @unique
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  customer   Customer       @relation(fields: [customerId], references: [id])
  receipt    Receipt?        @relation(fields: [receiptId], references: [id])
  createdBy  User            @relation("DebtCreator", fields: [createdById], references: [id])
  payments   DebtPayment[]
  extensions DebtExtension[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([offlineId])
}

model DebtPayment {
  id          String   @id @default(uuid())
  debtId      String
  amount      Decimal  @db.Decimal(12, 2)
  method      String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  debt      Debt @relation(fields: [debtId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([debtId])
  @@index([createdById])
}

model DebtExtension {
  id           String   @id @default(uuid())
  debtId       String
  oldDate      DateTime
  newDate      DateTime
  reason       String
  approvedById String
  createdAt    DateTime @default(now())

  debt       Debt @relation(fields: [debtId], references: [id])
  approvedBy User @relation("DebtExtensionApprover", fields: [approvedById], references: [id])

  @@index([debtId])
}

model ReturnReceipt {
  id          String   @id @default(uuid())
  receiptId   String
  total       Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  receipt Receipt             @relation(fields: [receiptId], references: [id])
  items   ReturnReceiptItem[]

  @@index([receiptId])
}

model ReturnReceiptItem {
  id              String  @id @default(uuid())
  returnReceiptId String
  productId       String
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)

  returnReceipt ReturnReceipt @relation(fields: [returnReceiptId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([returnReceiptId])
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  company   String?
  address   String?
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  balance   Decimal   @db.Decimal(12, 2) @default(0)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions SupplierTransaction[]

  @@index([name])
  @@index([isDeleted])
}

model SupplierTransaction {
  id          String   @id @default(uuid())
  supplierId  String
  type        String   // IMPORT, PAYMENT, RETURN
  total       Decimal  @db.Decimal(12, 2)
  paidAmount  Decimal  @db.Decimal(12, 2) @default(0)  // IMPORT uchun: kirim paytida naqd to'langan summa
  currency    String   @default("UZS")
  rate        Decimal  @db.Decimal(12, 4) @default(1)
  note        String?
  warehouseId String?
  createdById String
  createdAt   DateTime @default(now())

  supplier  Supplier                  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse?                @relation(fields: [warehouseId], references: [id])
  items     SupplierTransactionItem[]

  @@index([supplierId])
  @@index([createdAt])
  @@index([warehouseId])
}

model SupplierTransactionItem {
  id            String  @id @default(uuid())
  transactionId String
  productId     String
  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  transaction SupplierTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id])

  @@index([transactionId])
}

model Expense {
  id          String   @id @default(uuid())
  category    String   // RENT, SALARY, UTILITIES, TRANSPORT, MARKETING, REPAIR, TAX, OTHER
  type        String?  // Sub-kategoriya: elektr, suv, gaz, internet, ...
  amount      Decimal  @db.Decimal(12, 2)
  description String
  date        DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([date])
  @@index([createdById])
  @@index([category, date])
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  checkIn   DateTime
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  lat       Float?
  lng       Float?
  note      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([checkIn])
}

model StoreLocation {
  id            String  @id @default(uuid())
  name          String
  lat           Float
  lng           Float
  radius        Int     @default(100)  // meters
  address       String?
  workStartTime String  @default("09:00")  // Ish boshlanish vaqti
  isActive      Boolean @default(true)
  qrToken       String  @unique @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Salary {
  id         String       @id @default(uuid())
  userId     String
  month      String       // "2026-03"
  base       Decimal      @db.Decimal(12, 2)
  kpiBonus   Decimal      @db.Decimal(12, 2) @default(0)
  salesBonus Decimal      @db.Decimal(12, 2) @default(0)
  advances   Decimal      @db.Decimal(12, 2) @default(0)
  fines      Decimal      @db.Decimal(12, 2) @default(0)
  total      Decimal      @db.Decimal(12, 2)
  status     SalaryStatus @default(CALCULATED)
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, month])
  @@index([month])
  @@index([status])
}

model SalarySetting {
  id           String  @id @default(uuid())
  userId       String  @unique
  baseSalary   Decimal @db.Decimal(12, 2)
  salesPercent Decimal @db.Decimal(5, 2) @default(0)

  user User @relation(fields: [userId], references: [id])
}

model Advance {
  id           String        @id @default(uuid())
  userId       String
  amount       Decimal       @db.Decimal(12, 2)
  reason       String?
  status       AdvanceStatus @default(PENDING)
  approvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User  @relation("AdvanceUser", fields: [userId], references: [id])
  approvedBy User? @relation("AdvanceApprover", fields: [approvedById], references: [id])

  @@index([userId])
  @@index([status])
}

model KpiTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?
  targetValue Decimal @db.Decimal(12, 2)
  unit        String  // "count", "sum", "percent"
  bonusAmount Decimal @db.Decimal(12, 2)

  assignments KpiAssignment[]
}

model KpiAssignment {
  id         String   @id @default(uuid())
  templateId String
  userId     String
  month      String   // "2026-03"
  createdAt  DateTime @default(now())

  template KpiTemplate @relation(fields: [templateId], references: [id])
  user     User        @relation(fields: [userId], references: [id])
  records  KpiRecord[]

  @@unique([templateId, userId, month])
}

model KpiRecord {
  id           String  @id @default(uuid())
  assignmentId String
  value        Decimal @db.Decimal(12, 2)
  date         DateTime @default(now())
  userId       String

  assignment KpiAssignment @relation(fields: [assignmentId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  @@index([assignmentId])
}

model CashierSession {
  id             String    @id @default(uuid())
  userId         String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingBalance Decimal   @db.Decimal(12, 2) @default(0)
  closingBalance Decimal?  @db.Decimal(12, 2)
  note           String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([openedAt])
}

model Order {
  id          String      @id @default(uuid())
  number      Int         @default(autoincrement())
  customerId  String?
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(12, 2)
  note        String?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer    Customer?   @relation(fields: [customerId], references: [id])
  createdBy   User        @relation("OrderCreator", fields: [createdById], references: [id])
  items       OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  supplierTransactions SupplierTransaction[]
  warehouseStocks      WarehouseStock[]
  movementsFrom        StockMovement[] @relation("MovementFrom")
  movementsTo          StockMovement[] @relation("MovementTo")
}

// Har ombor uchun har mahsulotning alohida miqdori
model WarehouseStock {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
  @@index([warehouseId, quantity])
}

// Stock harakatlari tarixi: kirim, chiqim, ko'chirish, sotuv, qaytarish
enum StockMovementType {
  IMPORT          // Supplier'dan ombor'ga kirim
  ISSUE_TO_SHOP   // Ombor'dan do'kon'ga chiqim
  TRANSFER        // Ombor'dan boshqa ombor'ga ko'chirish
  SHOP_RETURN     // Mijoz qaytargan mahsulot (do'kon stock)
  ADJUSTMENT      // Qo'lda tuzatish (inventarizatsiya)
}

model StockMovement {
  id              String            @id @default(uuid())
  type            StockMovementType
  productId       String
  quantity        Int
  fromWarehouseId String?           // null bo'lsa: do'kondan yoki supplier'dan
  toWarehouseId   String?           // null bo'lsa: do'konga
  note            String?
  createdById     String
  createdAt       DateTime          @default(now())

  product       Product    @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("MovementTo", fields: [toWarehouseId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  phone       String
  categoryId  String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  category  ContactCategory? @relation(fields: [categoryId], references: [id])
  createdBy User?            @relation("ContactCreator", fields: [createdById], references: [id])

  @@index([name])
  @@index([phone])
  @@index([createdById])
}

model ContactCategory {
  id   String @id @default(uuid())
  name String

  contacts Contact[]
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  company   String?
  balance   Decimal  @db.Decimal(12, 2) @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments PartnerPayment[]
}

model PartnerPayment {
  id        String   @id @default(uuid())
  partnerId String
  amount    Decimal  @db.Decimal(12, 2)
  type      String   // IN, OUT
  note      String?
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

model Fine {
  id          String   @id @default(uuid())
  userId      String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String   // LATE, ABSENT, ERROR, OTHER
  month       String   // "2026-03"
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  user      User @relation("FineUser", fields: [userId], references: [id])
  createdBy User @relation("FineCreator", fields: [createdById], references: [id])

  @@index([userId])
  @@index([month])
  @@index([userId, month])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String
  oldData   Json?
  newData   Json?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  // Production: partitioning by month recommended
}

// ==================== MARKETPLACE ====================

enum MarketplaceOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model MarketplaceOrder {
  id            Int                    @id @default(autoincrement())
  customerName  String
  customerPhone String
  address       String?
  notes         String?
  status        MarketplaceOrderStatus @default(PENDING)
  totalUzs      Decimal                @db.Decimal(18, 2) @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  items MarketplaceOrderItem[]

  @@index([status])
  @@index([createdAt])
}

model MarketplaceOrderItem {
  id          Int              @id @default(autoincrement())
  orderId     Int
  order       MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  productName String
  quantity    Int              @default(1)
  priceUzs    Decimal          @db.Decimal(18, 2)
  totalUzs    Decimal          @db.Decimal(18, 2)

  @@index([orderId])
  @@index([productId])
}
