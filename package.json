{
  "name": "sardorbek-furnitura",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sardorbek/api --filter @sardorbek/web dev",
    "dev:api": "pnpm --filter @sardorbek/api dev",
    "dev:web": "pnpm --filter @sardorbek/web dev",
    "build": "pnpm --filter @sardorbek/shared build && pnpm --parallel --filter @sardorbek/api --filter @sardorbek/web build",
    "build:shared": "pnpm --filter @sardorbek/shared build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:load": "pnpm --filter @sardorbek/api test:load",
    "db:migrate": "pnpm --filter @sardorbek/api prisma migrate dev",
    "db:push": "pnpm --filter @sardorbek/api prisma db push",
    "db:seed": "pnpm --filter @sardorbek/api prisma db seed",
    "db:studio": "pnpm --filter @sardorbek/api prisma studio",
    "clean": "pnpm -r exec rm -rf dist node_modules .tsbuildinfo"
  },
  "devDependencies": {
    "mongoose": "^9.3.0",
    "vitest": "^3.0.0"
  }
}
